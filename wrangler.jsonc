{
  "name": "bhh-infirmary-p1-preview",
  "main": "cloudflare/worker/index.js",
  "compatibility_date": "2026-10-16",
  "workers_dev": true,
  "assets": {
    "directory": "./frontend/dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  }
}